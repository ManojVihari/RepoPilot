# Copy to .env and adjust. Never commit .env.

# Required: password of the bundled Postgres. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
MERGECLEAR_DB_PASSWORD=

# Background workers inside the server container (add more with the "workers" profile)
MERGECLEAR_WORKERS=2

# Accounts: the first visit creates the admin; admins add users under Settings → Users.
# "true" lets people create their own viewer account on the sign-in page.
MERGECLEAR_ALLOW_SIGNUP=false
# Session cookie "Secure" flag: "true" when the server is behind a TLS-terminating proxy
MERGECLEAR_COOKIE_SECURE=auto

# Port the server is published on
MERGECLEAR_PORT=8000

# "on" to have Ollama write docs, titles, change summaries and QA plans
# (start with: docker compose --profile llm up -d). "off": docs from scanned facts only.
MERGECLEAR_LLM=off
OLLAMA_MODEL=mistral
