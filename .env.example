# Copy to .env and adjust. Never commit .env.

# Required: scanners must send this token to upload reports (MERGECLEAR_TOKEN on the scanner side too).
# Generate one with:  openssl rand -hex 32
MERGECLEAR_TOKEN=

# Port the server is published on
MERGECLEAR_PORT=8000

# "on" to have Ollama write docs, titles, change summaries and QA plans
# (start with: docker compose --profile llm up -d). "off": docs from scanned facts only.
MERGECLEAR_LLM=off
OLLAMA_MODEL=mistral
