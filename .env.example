# Copy to .env and adjust. Never commit .env.

# Server image version to run (ghcr.io/manojvihari/mergeclear-server). Pin it in production;
# "latest" follows every release.
MERGECLEAR_VERSION=0.3.0

# Required: password of the bundled Postgres. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
MERGECLEAR_DB_PASSWORD=

# Background workers inside the server container (add more with the "workers" profile)
MERGECLEAR_WORKERS=2

# Accounts: the first visit creates the admin; admins add users under Settings → Users.
# "true" lets people create their own viewer account on the sign-in page.
MERGECLEAR_ALLOW_SIGNUP=false
# Session cookie "Secure" flag: "true" when the server is behind a TLS-terminating proxy
MERGECLEAR_COOKIE_SECURE=auto

# Port the server is published on (bound to 127.0.0.1 only with docker-compose.https.yml)
MERGECLEAR_PORT=8000

# HTTPS with docker-compose.https.yml: the public name of this server (DNS pointing here,
# ports 80 and 443 reachable). Caddy gets the certificate.
MERGECLEAR_DOMAIN=
# Behind your own proxy instead (nginx, load balancer): its IP, so X-Forwarded-Proto is trusted
# (and set MERGECLEAR_COOKIE_SECURE=true)
MERGECLEAR_TRUSTED_PROXIES=127.0.0.1

# Limits: largest upload in MB, uploads per account per minute (0 = no limit)
MERGECLEAR_MAX_UPLOAD_MB=25
MERGECLEAR_UPLOADS_PER_MINUTE=30

# "on" to have Ollama write docs, titles, change summaries and QA plans
# (start with: docker compose --profile llm up -d). "off": docs from scanned facts only.
MERGECLEAR_LLM=off
OLLAMA_MODEL=mistral
